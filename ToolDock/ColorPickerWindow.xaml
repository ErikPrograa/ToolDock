<Window x:Class="ToolDock.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440" Height="700" MinWidth="400" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource AccentForegroundBrush}"
        FontFamily="Segoe UI Variable" UseLayoutRounding="True">
    <DockPanel Margin="22">
        <UniformGrid DockPanel.Dock="Bottom" Columns="2" Margin="0,16,0,0">
            <Button x:Name="DoneButton" Margin="0,0,4,0" IsDefault="True" Click="Done_Click" />
            <Button x:Name="CancelButton" Margin="4,0,0,0" IsCancel="True" />
        </UniformGrid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock x:Name="Heading" FontSize="20" FontWeight="SemiBold"
                           TextWrapping="Wrap" Margin="0,0,0,20" />
                <Grid Height="220">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="60" />
                    </Grid.ColumnDefinitions>
                    <Grid x:Name="Spectrum" Background="Transparent" Focusable="True" Margin="0,0,12,0"
                          MouseLeftButtonDown="Spectrum_MouseLeftButtonDown"
                          MouseMove="Spectrum_MouseMove" MouseLeftButtonUp="Spectrum_MouseLeftButtonUp"
                          KeyDown="Spectrum_KeyDown" SizeChanged="Spectrum_SizeChanged">
                        <Rectangle>
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0" ColorInterpolationMode="SRgbLinearInterpolation">
                                    <GradientStop Color="#FF0000" Offset="0" />
                                    <GradientStop Color="#FFFF00" Offset="0.1666667" />
                                    <GradientStop Color="#00FF00" Offset="0.3333333" />
                                    <GradientStop Color="#00FFFF" Offset="0.5" />
                                    <GradientStop Color="#0000FF" Offset="0.6666667" />
                                    <GradientStop Color="#FF00FF" Offset="0.8333333" />
                                    <GradientStop Color="#FF0000" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Rectangle>
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00FFFFFF" Offset="0" />
                                    <GradientStop Color="#FFFFFFFF" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Canvas IsHitTestVisible="False">
                            <Grid x:Name="SelectionMarker" Width="16" Height="16">
                                <Ellipse Stroke="Black" StrokeThickness="3" />
                                <Ellipse Stroke="White" StrokeThickness="2" />
                            </Grid>
                        </Canvas>
                    </Grid>
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <Border x:Name="OriginalPreview" BorderThickness="1" BorderBrush="{DynamicResource ControlBorderBrush}" />
                        <Border x:Name="ColorPreview" Grid.Row="1" BorderThickness="1" BorderBrush="{DynamicResource ControlBorderBrush}" />
                    </Grid>
                </Grid>
                <TextBlock x:Name="ValueLabel" Margin="0,14,0,2" />
                <Slider x:Name="ValueSlider" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10"
                        IsMoveToPointEnabled="True" ValueChanged="ValueSlider_ValueChanged">
                    <Slider.Template>
                        <ControlTemplate TargetType="Slider">
                            <Grid>
                                <Border Height="10" Margin="9,0" CornerRadius="5" Background="{TemplateBinding Background}" />
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Opacity="0" Focusable="False" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Opacity="0" Focusable="False" />
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{DynamicResource SliderThumbStyle}" />
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Slider.Template>
                </Slider>
                <Grid Margin="0,16,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="ColorModel" Margin="0,0,8,0" SelectionChanged="ColorModel_SelectionChanged">
                        <ComboBoxItem Content="RGB" />
                        <ComboBoxItem Content="HSV" />
                    </ComboBox>
                    <TextBox x:Name="HexInput" Grid.Column="1" AutomationProperties.Name="HEX"
                             TextChanged="HexInput_TextChanged" />
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBox x:Name="FirstInput" Margin="0,0,8,8" TextChanged="Component_TextChanged" />
                    <TextBlock x:Name="FirstLabel" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,0,8" />
                    <TextBox x:Name="SecondInput" Grid.Row="1" Margin="0,0,8,8" TextChanged="Component_TextChanged" />
                    <TextBlock x:Name="SecondLabel" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,0,8" />
                    <TextBox x:Name="ThirdInput" Grid.Row="2" Margin="0,0,8,0" TextChanged="Component_TextChanged" />
                    <TextBlock x:Name="ThirdLabel" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" />
                </Grid>
                <TextBlock x:Name="ValidationMessage" Margin="0,10,0,0" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite" Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
