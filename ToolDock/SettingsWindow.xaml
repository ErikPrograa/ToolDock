                                    MinWidth="220"
                                    HorizontalAlignment="Left"
                                    Padding="12,6"
                                    Margin="0,0,0,6"
                                    Click="SoftResetButton_Click"
                                    chrome:FluentChrome.Icon="&#xE72C;" />
                            <TextBlock x:Name="SoftResetDescriptionText"
                                       TextWrapping="Wrap"
                                       Opacity="0.82"
                                       FontSize="12"
                                       Margin="0,0,0,14" />
                            <Button x:Name="HardResetButton"
                                    Width="Auto"
                                    MinWidth="220"
                                    HorizontalAlignment="Left"
                                    Padding="12,6"
                                    Margin="0,0,0,6"
                                    Click="HardResetButton_Click"
                                    chrome:FluentChrome.Icon="&#xE777;" />
                            <TextBlock x:Name="HardResetDescriptionText"
                                       TextWrapping="Wrap"
                                       Opacity="0.82"
                                       FontSize="12"
                                       Margin="0,0,0,14" />
                            <Button x:Name="UltraHardResetButton"
                                    Width="Auto"
                                    MinWidth="220"
                                    HorizontalAlignment="Left"
                                    Padding="12,6"
                                    Margin="0,0,0,6"
                                    Click="UltraHardResetButton_Click"
                                    chrome:FluentChrome.Icon="&#xE7BA;" />
                            <TextBlock x:Name="UltraHardResetDescriptionText"
                                       TextWrapping="Wrap"
                                       Opacity="0.82"
                                       FontSize="12"
                                       Margin="0,0,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

            <Border Grid.Row="2"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="0,1,0,0"
                    Margin="0,8,0,0"
                    Padding="0,12,0,2">
                <WrapPanel HorizontalAlignment="Right">
                    <Button x:Name="ResetPresetButton"
                            FontSize="12"
                            Padding="10,5"
                            Margin="3,2"
                            Click="ResetPresetButton_Click"
                            chrome:FluentChrome.Icon="&#xE72C;" />
                    <Button x:Name="ResetDefaultsButton"
                            FontSize="12"
                            Padding="10,5"
                            Margin="3,2"
                            Click="ResetDefaultsButton_Click"
                            chrome:FluentChrome.Icon="&#xE777;" />
                    <Button x:Name="RefreshWindowButton"
                            FontSize="12"
                            Padding="10,5"
                            Margin="3,2"
                            Click="RefreshWindowButton_Click"
                            chrome:FluentChrome.Icon="&#xE7F4;" />
                    <Button x:Name="ReloadAppButton"
                            FontSize="12"
                            Padding="10,5"
                            Margin="3,2"
                            Click="ReloadAppButton_Click"
                            chrome:FluentChrome.Icon="&#xE72C;" />
                    <!-- Oculto: la X de la ventana hace lo mismo. El botón y su handler se conservan. -->
                    <Button x:Name="CloseButton"
                            Visibility="Collapsed"
                            FontSize="12"
                            Padding="10,5"
                            Margin="3,2"
                            Click="CloseButton_Click"
                            chrome:FluentChrome.Icon="&#xE711;" />
                </WrapPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
