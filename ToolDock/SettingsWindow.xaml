                                        </ComboBox>
                                        <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE774;" Margin="12,0,0,0" HorizontalAlignment="Left" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SettingsCard}">
                                <StackPanel>
                                    <TextBlock x:Name="ThemeLabel" Style="{StaticResource CardTitle}" />
